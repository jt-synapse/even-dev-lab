{
  "name": "even-dev-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": "24.22.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "experiments/*"
  ],
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "dev:lab": "yarn workspace @even-dev-lab/device-lab dev",
    "preview:lab": "yarn workspace @even-dev-lab/device-lab preview",
    "sim:lab": "node scripts/sim-lab.mjs",
    "test:sim": "node scripts/test-sim.mjs",
    "qr:lab": "node scripts/qr-lab.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && yarn workspace @even-dev-lab/device-lab typecheck",
    "test": "node --test scripts/doctor.test.mjs scripts/sim-harness.test.mjs && yarn workspace @even-dev-lab/device-lab test",
    "build": "yarn workspace @even-dev-lab/device-lab build",
    "check": "node scripts/doctor.mjs && prettier --check . && eslint . && yarn typecheck && yarn test && yarn build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
